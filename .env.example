# Copy this file to .env beside the compiled executable. Existing process
# environment variables take precedence. The file is plain text, not encrypted:
# restrict access to it, never commit it, and never share real API keys.
# `go run .` finds this file through the current-directory fallback.
# Cloud providers are tried in this order: Gemini, Cerebras, Groq, Mistral, OpenRouter.
# Ollama remains the final local fallback.

# Gemini
# Free-tier API access is account- and rate-limited; the model is not guaranteed zero-price.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cerebras
# qwen-3-32b supports strict structured output. Free-tier access is account- and
# rate-limited; it is not guaranteed to remain permanently zero-cost.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-32b
# Optional path override; the host must remain https://api.cerebras.ai.
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Groq
# Groq Free Plan access is rate-limited; this production model also has paid-plan pricing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral
# Studio Free mode requires an account and has usage/rate limits; this is not a zero-price model.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenRouter
# The :free endpoint is zero-priced but rate-limited and availability can change.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama fallback (all values are optional)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT=30m
