# Provider chain order. This example tries Gemini first, then local Ollama.
# Remove "gemini" or leave PROVIDER_CHAIN unset to use only local Ollama.
# Names may contain letters, numbers, underscores, and hyphens. Hyphens map to underscores for env variables.
PROVIDER_CHAIN=gemini,ollama

# Gemini OpenAI-compatible API.
# Get a key from Google AI Studio, then replace the placeholder below.
PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PROVIDER_GEMINI_API_KEY=replace-with-your-gemini-api-key
PROVIDER_GEMINI_MODEL=gemini-3.1-flash-lite
PROVIDER_GEMINI_MODE=json_schema

# Additional OpenAI-compatible provider example.
# Add "together" to PROVIDER_CHAIN before enabling these values.
# PROVIDER_TOGETHER_BASE_URL=https://api.together.xyz/v1
# PROVIDER_TOGETHER_API_KEY=replace-with-your-together-api-key
# PROVIDER_TOGETHER_MODEL=replace-with-model-name
# PROVIDER_TOGETHER_MODE=json_object

# Local Ollama OpenAI-compatible endpoint. Used only when "ollama" appears in
# PROVIDER_CHAIN, or when PROVIDER_CHAIN is unset. No API key is required.
PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
PROVIDER_OLLAMA_MODEL=qwen3:8b
PROVIDER_OLLAMA_TIMEOUT=10m
PROVIDER_OLLAMA_MODE=json_schema
