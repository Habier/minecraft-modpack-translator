# Provider chain order. This example tries Gemini first, then local Ollama.
# Remove "gemini" or leave PROVIDER_CHAIN unset to use only local Ollama.
# Names may contain letters, numbers, underscores, and hyphens. Hyphens map to underscores for env variables.
PROVIDER_CHAIN=gemini,ollama

# Required; no default. Must be an HTTPS URL without credentials, query, or fragment.
#PROVIDER_EXAMPLE_BASE_URL=https://api.example.com/v1
# Required; no default.
#PROVIDER_EXAMPLE_API_KEY=replace-with-your-api-key
# Required; no default. Use a model name supported by the provider.
#PROVIDER_EXAMPLE_MODEL=example-model
# Optional. Default: 8192. Range: 1024-1048576. Effective deployment context
# capacity used only for conservative local batch planning; this does not configure the provider server.
#PROVIDER_EXAMPLE_CONTEXT_TOKENS=8192
# Optional safety cap. Default: 100. Range: 1-10000.
#PROVIDER_EXAMPLE_MAX_ENTRIES=100
# Optional. Default: 2048. Range: 1-262144; must be less than CONTEXT_TOKENS.
#PROVIDER_EXAMPLE_MAX_OUTPUT_TOKENS=2048
# Optional. Default: 98304. Range: 1-4194304.
#PROVIDER_EXAMPLE_MAX_REQUEST_BYTES=98304
# Optional. Options: json_schema, json_object. Default: json_schema.
#PROVIDER_EXAMPLE_MODE=json_schema
# Optional. Options: minimal, low, medium, high. Omitted by default for providers other than Gemini.
#PROVIDER_EXAMPLE_REASONING_EFFORT=low


# Gemini OpenAI-compatible API.
# Get a key from Google AI Studio, then replace the placeholder below.
PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PROVIDER_GEMINI_API_KEY=replace-with-your-gemini-api-key
PROVIDER_GEMINI_MODEL=gemini-3.1-flash-lite
PROVIDER_GEMINI_CONTEXT_TOKENS=8192
PROVIDER_GEMINI_MAX_ENTRIES=100
PROVIDER_GEMINI_MAX_OUTPUT_TOKENS=4096
PROVIDER_GEMINI_MAX_REQUEST_BYTES=98304
PROVIDER_GEMINI_MODE=json_schema
PROVIDER_GEMINI_REASONING_EFFORT=low

# Local Ollama OpenAI-compatible endpoint. No API key is required.
PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
PROVIDER_OLLAMA_MODEL=qwen3.5:9b
PROVIDER_OLLAMA_TIMEOUT=10m
PROVIDER_OLLAMA_CONTEXT_TOKENS=8192
PROVIDER_OLLAMA_MAX_OUTPUT_TOKENS=2048
PROVIDER_OLLAMA_MAX_REQUEST_BYTES=98304
PROVIDER_OLLAMA_MAX_ENTRIES=100
